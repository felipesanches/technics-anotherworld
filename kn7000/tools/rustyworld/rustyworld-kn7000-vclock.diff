--- /dev/null
+++ b/src/bin/dumpres.rs
@@ -0,0 +1,14 @@
+// Unpack every resource of the MSDOS data set (data/ in cwd) with the reference's own unpacker and
+// write dump_NN.bin, to compare against the port's extracted resources (tools/aw_extract.py).
+use rustyworld::FileResourceManager;
+use std::fs;
+fn main() {
+    let rm = FileResourceManager::new().expect("index");
+    for id in 0u8..rm.resources.len() as u8 {
+        match rm.read_resource(id) {
+            Ok(buf) => { fs::write(format!("dump_{:02X}.bin", id), &buf).unwrap();
+                         eprintln!("{:02X}: {} bytes", id, buf.len()); }
+            Err(e) => eprintln!("{:02X}: ERR {}", id, e),
+        }
+    }
+}
diff --git a/src/bin/refcksum.rs b/src/bin/refcksum.rs
new file mode 100644
index 0000000..f81aac2
--- /dev/null
+++ b/src/bin/refcksum.rs
@@ -0,0 +1,138 @@
+// Reference per-frame checksum generator for the KN7000 Another World port.
+//
+// Drives rustyworld's faithful VM+renderer through the intro (part 0x3E81),
+// loading the ORIGINAL MSDOS data (data/ in cwd, byte-identical to the resources
+// our KN7000 port runs), and writes one line per VM tick:  "<tick> <crc32hex>"
+// where the crc32 (IEEE/zlib) is over the 64000-byte front-page palette-index
+// buffer. Audio/music/input are stubbed; var 0x3C seed is patched to 0x1234 in
+// the VM to match the port, so RNG-driven scenes are identical.
+//
+//   cargo run --no-default-features --bin refcksum -- <logpath> [max_ticks]
+// run from a dir containing data/MEMLIST.BIN + data/BANK0*.
+use std::cell::RefCell;
+use std::collections::HashSet;
+use std::io::Write;
+use std::rc::Rc;
+
+use rustyworld::audio::Audio;
+use rustyworld::input::{Input, InputDevice};
+use rustyworld::music::Music;
+use rustyworld::video::{DefaultVideo, VideoAdapter, TOT_PIXELS};
+use rustyworld::{FileResourceManager, Vm};
+
+/// Captures the latest presented front buffer so the run loop can checksum it
+/// at each tick boundary (even on ticks that did not present, the last frame
+/// persists — matching the KN7000's CUR_PAGE_2 read per FRAME_NO tick).
+struct Capture {
+    latest: Vec<u8>,
+}
+struct CksumAdapter {
+    cap: Rc<RefCell<Capture>>,
+}
+impl VideoAdapter for CksumAdapter {
+    fn update_display(&mut self, buffer: &[u8]) {
+        self.cap.borrow_mut().latest.copy_from_slice(buffer);
+    }
+    fn set_palette(&mut self, _palette: &[u32]) {}
+}
+
+struct StubAudio;
+impl Audio for StubAudio {
+    fn play_sound(&mut self, _: &[u8], _: u8, _: u8, _: u8) {}
+    fn stop(&mut self) {}
+}
+struct StubMusic;
+impl Music for StubMusic {
+    fn start(&mut self, _: u16, _: Option<u16>, _: u8) {}
+    fn delay(&mut self, _: u16) {}
+    fn stop(&mut self) {}
+    fn latest_mark(&mut self) -> Option<i16> {
+        None
+    }
+}
+struct StubInput;
+impl InputDevice for StubInput {
+    fn read_input(&self) -> HashSet<Input> {
+        let mut h = HashSet::new();
+        match std::env::var("AW_IN").as_deref() {
+            Ok("button") => { h.insert(Input::BUTTON); }
+            Ok("up")     => { h.insert(Input::UP); }
+            Ok("down")   => { h.insert(Input::DOWN); }
+            Ok("left")   => { h.insert(Input::LEFT); }
+            Ok("right")  => { h.insert(Input::RIGHT); }
+            _ => {}
+        }
+        h
+    }
+}
+
+/// Standard IEEE (zlib) CRC-32, matches Python zlib.crc32 on the KN7000 side.
+fn crc32(data: &[u8]) -> u32 {
+    let mut crc: u32 = 0xFFFF_FFFF;
+    for &b in data {
+        crc ^= b as u32;
+        for _ in 0..8 {
+            let m = (crc & 1).wrapping_neg(); // 0xFFFFFFFF if LSB set, else 0
+            crc = (crc >> 1) ^ (0xEDB8_8320 & m);
+        }
+    }
+    !crc
+}
+
+fn main() {
+    let args: Vec<String> = std::env::args().collect();
+    let logpath = args
+        .get(1)
+        .cloned()
+        .unwrap_or_else(|| "ref_checksums.log".to_string());
+    let max_ticks: u32 = args.get(2).and_then(|s| s.parse().ok()).unwrap_or(5000);
+    if let Ok(t) = std::env::var("DUMP_TICK") {
+        if let Ok(t) = t.parse::<i64>() {
+            rustyworld::dbg::DUMP_TICK.store(t, std::sync::atomic::Ordering::Relaxed);
+        }
+    }
+
+    let cap = Rc::new(RefCell::new(Capture {
+        latest: vec![0u8; TOT_PIXELS],
+    }));
+    let video = DefaultVideo::new(CksumAdapter { cap: cap.clone() });
+    let resman = Rc::new(FileResourceManager::new().expect("index resources (need data/ in cwd)"));
+    let mut vm = Vm::new(
+        1_000_000, // speed_up: effectively disables the real-time frame throttle
+        video,
+        resman,
+        StubInput,
+        Box::new(StubAudio),
+        Box::new(StubMusic),
+    );
+
+    let mut log = std::io::BufWriter::new(std::fs::File::create(&logpath).unwrap());
+    // Optional raw per-frame page dump (same layout as the KN7000 awcksum probe:
+    // a .bin of 64000-byte front pages + a .idx of "tick frontaddr"), so pixels
+    // can be diffed frame-for-frame. Enable with REF_BIN (and optional REF_IDX).
+    let mut pages = std::env::var("REF_BIN").ok().map(|p| {
+        let idx = std::env::var("REF_IDX").unwrap_or_else(|_| format!("{}.idx", p));
+        (
+            std::io::BufWriter::new(std::fs::File::create(&p).unwrap()),
+            std::io::BufWriter::new(std::fs::File::create(&idx).unwrap()),
+        )
+    });
+    let mut count = 0u32;
+    vm.run_headless(|tick| {
+        let c = cap.borrow();
+        let crc = crc32(&c.latest);
+        writeln!(log, "{} {:08x}", tick, crc).unwrap();
+        if let Some((ref mut binf, ref mut idxf)) = pages {
+            binf.write_all(&c.latest).unwrap();
+            writeln!(idxf, "{} 00000000", tick).unwrap();
+        }
+        count = tick + 1;
+        tick + 1 < max_ticks
+    });
+    log.flush().unwrap();
+    if let Some((ref mut binf, ref mut idxf)) = pages {
+        binf.flush().unwrap();
+        idxf.flush().unwrap();
+    }
+    eprintln!("refcksum: wrote {} ({} ticks)", logpath, count);
+}
diff --git a/src/bin/replayawr.rs b/src/bin/replayawr.rs
new file mode 100644
index 0000000..82a01ee
--- /dev/null
+++ b/src/bin/replayawr.rs
@@ -0,0 +1,109 @@
+// replayawr: the reference VM replays a session from the KN7000 port's input log (kn7000 src/inplog.s, as
+// tools/aw_inplog.py writes it: SESSION.awr) and writes one "<tick> <crc32hex>" line per tick over the 64000-byte
+// front page: the format of the port's pages.log (probes/cnv/run_inplog.sh), so that probes/compare_frames.py diffs
+// the two frame for frame. Any divergence is the port's VM (or this reference's): the input is the same.
+//
+//   cargo build --release --no-default-features --bin replayawr
+//   replayawr SESSION.awr OUT.log [max_ticks]      (from a dir with data/MEMLIST.BIN + data/BANK0*)
+// Optional REF_BIN/REF_IDX dump the pages; REF_VARS the 256 variables after each tick (int16 LE); DUMP_TICK=<t> traces that tick's opcodes (Vm::execute);
+// AW_EVENTS=<file> logs sound/music/palette/string/memlist ops per tick+thread+pc, AW_EVENTS_POLY=1 adds polygon draws.
+use std::cell::RefCell;
+use std::collections::HashSet;
+use std::io::{BufRead, Write};
+use std::rc::Rc;
+
+use rustyworld::audio::Audio;
+use rustyworld::input::{Input, InputDevice};
+use rustyworld::music::Music;
+use rustyworld::video::{DefaultVideo, VideoAdapter, TOT_PIXELS};
+use rustyworld::vm::AwrLog;
+use rustyworld::{FileResourceManager, Vm};
+
+struct Capture { latest: Vec<u8> }
+struct CksumAdapter { cap: Rc<RefCell<Capture>> }
+impl VideoAdapter for CksumAdapter {
+    fn update_display(&mut self, buffer: &[u8]) { self.cap.borrow_mut().latest.copy_from_slice(buffer); }
+    fn set_palette(&mut self, _p: &[u32]) {}
+}
+struct StubAudio;
+impl Audio for StubAudio { fn play_sound(&mut self,_:&[u8],_:u8,_:u8,_:u8){} fn stop(&mut self){} }
+struct StubMusic;
+impl Music for StubMusic {
+    fn start(&mut self,_:u16,_:Option<u16>,_:u8){} fn delay(&mut self,_:u16){} fn stop(&mut self){}
+    fn latest_mark(&mut self)->Option<i16>{None}
+}
+struct StubInput;
+impl InputDevice for StubInput { fn read_input(&self)->HashSet<Input>{HashSet::new()} }
+
+fn crc32(data: &[u8]) -> u32 {
+    let mut crc: u32 = 0xFFFF_FFFF;
+    for &b in data {
+        crc ^= b as u32;
+        for _ in 0..8 { let m = (crc & 1).wrapping_neg(); crc = (crc >> 1) ^ (0xEDB8_8320 & m); }
+    }
+    !crc
+}
+
+fn hex(s: &str) -> u16 { u16::from_str_radix(s.trim_start_matches("0x"), 16).expect("hex") }
+
+fn load(path: &str) -> (AwrLog, Option<u32>) {
+    let f = std::fs::File::open(path).expect("open the .awr");
+    let mut log = AwrLog::default();
+    let (mut first, mut end) = (true, None);
+    for line in std::io::BufReader::new(f).lines().flatten() {
+        let c: Vec<&str> = line.split_whitespace().collect();
+        if c.is_empty() || c[0].starts_with('#') { continue; }
+        let frame: u32 = c[1].parse().expect("frame");
+        match c[0] {
+            "P" => if first { log.start_part = hex(c[2]); first = false; },
+            "I" => log.inputs.push((frame, c[2] == "intro", hex(c[3]))),
+            "R" => { log.reqs.insert(frame, hex(c[2])); }
+            "M" => log.marks.push((frame, c[2].parse().expect("thread"), c[3].parse().expect("mark"))),
+            "E" => end = Some(frame),
+            _ => panic!("unknown record {}", c[0]),
+        }
+    }
+    (log, end)
+}
+
+fn main() {
+    let args: Vec<String> = std::env::args().collect();
+    let awr = args.get(1).cloned().expect("replayawr SESSION.awr OUT.log [max_ticks]");
+    let logpath = args.get(2).cloned().unwrap_or_else(|| "replayawr.log".into());
+    let (session, end) = load(&awr);
+    let max_ticks: u32 = args.get(3).and_then(|s| s.parse().ok()).or(end).unwrap_or(6000);
+    eprintln!("replayawr: {}: first part {:#x}, {} input changes, {} marks, {} requests; up to tick {}",
+        awr, session.start_part, session.inputs.len(), session.marks.len(), session.reqs.len(), max_ticks);
+    if let Ok(t) = std::env::var("DUMP_TICK") {
+        if let Ok(t) = t.parse::<i64>() { rustyworld::dbg::DUMP_TICK.store(t, std::sync::atomic::Ordering::Relaxed); }
+    }
+    rustyworld::dbg::init_events();
+    let cap = Rc::new(RefCell::new(Capture { latest: vec![0u8; TOT_PIXELS] }));
+    let video = DefaultVideo::new(CksumAdapter { cap: cap.clone() });
+    let resman = Rc::new(FileResourceManager::new().expect("index resources (need data/ in cwd)"));
+    let mut vm = Vm::new(1_000_000, video, resman, StubInput, Box::new(StubAudio), Box::new(StubMusic));
+    let mut log = std::io::BufWriter::new(std::fs::File::create(&logpath).unwrap());
+    let mut pages = std::env::var("REF_BIN").ok().map(|p| {
+        let idx = std::env::var("REF_IDX").unwrap_or_else(|_| format!("{}.idx", p));
+        (std::io::BufWriter::new(std::fs::File::create(&p).unwrap()),
+         std::io::BufWriter::new(std::fs::File::create(&idx).unwrap()))
+    });
+    let mut vars_out = std::env::var("REF_VARS").ok().map(|p| std::io::BufWriter::new(std::fs::File::create(&p).unwrap()));
+    let mut count = 0u32;
+    vm.run_awr(&session, |tick, vars| {
+        if let Some(ref mut vf) = vars_out { for v in vars.iter() { vf.write_all(&v.to_le_bytes()).unwrap(); } }
+        let c = cap.borrow();
+        writeln!(log, "{} {:08x}", tick, crc32(&c.latest)).unwrap();
+        if let Some((ref mut binf, ref mut idxf)) = pages {
+            binf.write_all(&c.latest).unwrap();
+            writeln!(idxf, "{} 00000000", tick).unwrap();
+        }
+        count = tick + 1;
+        tick + 1 < max_ticks
+    });
+    log.flush().unwrap();
+    if let Some(ref mut vf) = vars_out { vf.flush().unwrap(); }
+    if let Some((ref mut binf, ref mut idxf)) = pages { binf.flush().unwrap(); idxf.flush().unwrap(); }
+    rustyworld::dbg::flush_events();
+    eprintln!("replayawr: wrote {} ({} ticks)", logpath, count);
+}
diff --git a/src/bin/replaycksum.rs b/src/bin/replaycksum.rs
new file mode 100644
index 0000000..79a7f67
--- /dev/null
+++ b/src/bin/replaycksum.rs
@@ -0,0 +1,99 @@
+// Differential-REPLAY per-frame checksum generator. Feeds the reference rustyworld VM the
+// exact per-frame hero inputs recorded from a KN7000 play session (probes/awmonitor.lua ->
+// aw-inputs.csv) and writes one "<tick> <crc32hex>" line per VM tick over the 64000-byte
+// front page -- so it can be diffed, frame-for-frame, against the KN7000 port replayed on the
+// SAME inputs (probes/awreplay.lua + cksum_pages.py). Any divergence is pure VM-logic/render.
+//
+//   cargo run --no-default-features --bin replaycksum -- <aw-inputs.csv> <logpath> [max_ticks]
+// run from a dir with data/MEMLIST.BIN + data/BANK0*. Optional REF_BIN/REF_IDX dump the pages.
+use std::cell::RefCell;
+use std::collections::{HashMap, HashSet};
+use std::io::{BufRead, Write};
+use std::rc::Rc;
+
+use rustyworld::audio::Audio;
+use rustyworld::input::{Input, InputDevice};
+use rustyworld::music::Music;
+use rustyworld::video::{DefaultVideo, VideoAdapter, TOT_PIXELS};
+use rustyworld::{FileResourceManager, Vm};
+
+struct Capture { latest: Vec<u8> }
+struct CksumAdapter { cap: Rc<RefCell<Capture>> }
+impl VideoAdapter for CksumAdapter {
+    fn update_display(&mut self, buffer: &[u8]) { self.cap.borrow_mut().latest.copy_from_slice(buffer); }
+    fn set_palette(&mut self, _p: &[u32]) {}
+}
+struct StubAudio;
+impl Audio for StubAudio { fn play_sound(&mut self,_:&[u8],_:u8,_:u8,_:u8){} fn stop(&mut self){} }
+struct StubMusic;
+impl Music for StubMusic {
+    fn start(&mut self,_:u16,_:Option<u16>,_:u8){} fn delay(&mut self,_:u16){} fn stop(&mut self){}
+    fn latest_mark(&mut self)->Option<i16>{None}
+}
+struct StubInput;
+impl InputDevice for StubInput { fn read_input(&self)->HashSet<Input>{HashSet::new()} }
+
+fn crc32(data: &[u8]) -> u32 {
+    let mut crc: u32 = 0xFFFF_FFFF;
+    for &b in data {
+        crc ^= b as u32;
+        for _ in 0..8 { let m = (crc & 1).wrapping_neg(); crc = (crc >> 1) ^ (0xEDB8_8320 & m); }
+    }
+    !crc
+}
+
+fn load_inputs(path: &str) -> HashMap<u32,[i16;6]> {
+    let f = std::fs::File::open(path).expect("open aw-inputs.csv");
+    let mut m = HashMap::new();
+    for line in std::io::BufReader::new(f).lines().flatten() {
+        if line.starts_with('#') || line.starts_with("frame") || line.trim().is_empty() { continue; }
+        let c: Vec<&str> = line.split(',').collect();
+        if c.len() < 8 { continue; }
+        let frame: u32 = match c[0].trim().parse() { Ok(v)=>v, _=>continue };
+        if frame < 1 { continue; } // frame 0 = pre-first-frame (matches awcksum ignoring the zero-write)
+        // columns: frame,part,lr,ud,jump,posmask,action,actmask. Key by frame-1 so this VM's
+        // tick T (0-based, like refcksum) lines up with awcksum's tick = FRAME_NO-1.
+        let v = |i:usize| c[i].trim().parse::<i32>().unwrap_or(0) as i16;
+        m.insert(frame - 1, [v(2), v(3), v(4), v(5), v(6), v(7)]);
+    }
+    m
+}
+
+fn main() {
+    let args: Vec<String> = std::env::args().collect();
+    let csv = args.get(1).cloned().unwrap_or_else(|| "aw-inputs.csv".into());
+    let logpath = args.get(2).cloned().unwrap_or_else(|| "replay_checksums.log".into());
+    let max_ticks: u32 = args.get(3).and_then(|s| s.parse().ok()).unwrap_or(6000);
+    let inputs = load_inputs(&csv);
+    eprintln!("replaycksum: loaded {} input rows from {}", inputs.len(), csv);
+    // DUMP_TICK=<t> enables the per-opcode PCT trace (in Vm::execute) for that tick.
+    if let Ok(t) = std::env::var("DUMP_TICK") {
+        if let Ok(t) = t.parse::<i64>() { rustyworld::dbg::DUMP_TICK.store(t, std::sync::atomic::Ordering::Relaxed); }
+    }
+
+    let cap = Rc::new(RefCell::new(Capture { latest: vec![0u8; TOT_PIXELS] }));
+    let video = DefaultVideo::new(CksumAdapter { cap: cap.clone() });
+    let resman = Rc::new(FileResourceManager::new().expect("index resources (need data/ in cwd)"));
+    let mut vm = Vm::new(1_000_000, video, resman, StubInput, Box::new(StubAudio), Box::new(StubMusic));
+
+    let mut log = std::io::BufWriter::new(std::fs::File::create(&logpath).unwrap());
+    let mut pages = std::env::var("REF_BIN").ok().map(|p| {
+        let idx = std::env::var("REF_IDX").unwrap_or_else(|_| format!("{}.idx", p));
+        (std::io::BufWriter::new(std::fs::File::create(&p).unwrap()),
+         std::io::BufWriter::new(std::fs::File::create(&idx).unwrap()))
+    });
+    let mut count = 0u32;
+    vm.run_replay(&inputs, |tick| {
+        let c = cap.borrow();
+        writeln!(log, "{} {:08x}", tick, crc32(&c.latest)).unwrap();
+        if let Some((ref mut binf, ref mut idxf)) = pages {
+            binf.write_all(&c.latest).unwrap();
+            writeln!(idxf, "{} 00000000", tick).unwrap();
+        }
+        count = tick + 1;
+        tick + 1 < max_ticks
+    });
+    log.flush().unwrap();
+    if let Some((ref mut binf, ref mut idxf)) = pages { binf.flush().unwrap(); idxf.flush().unwrap(); }
+    eprintln!("replaycksum: wrote {} ({} ticks)", logpath, count);
+}
diff --git a/src/bin/replaywatch.rs b/src/bin/replaywatch.rs
new file mode 100644
index 0000000..88542ed
--- /dev/null
+++ b/src/bin/replaywatch.rs
@@ -0,0 +1,140 @@
+// Watch a recorded KN7000 play session in the reference VM, in a window, at authentic speed.
+//
+// Input: the RAW events file from probes/awmonitor.lua (aw-<session>-events.csv): every key
+// make/break (keybed or MIDI) and every ReadInput instant of the KN7000 run. For each VM tick T
+// this rebuilds the set of keys the player was physically holding at the KN7000's ReadInput for
+// tick T, maps notes to Another World inputs with the port's keyboard layout (C4 and below =
+// action, F5 left, A5 down, C6 right, Bb5/B5 up; plus the panel D-pad), and hands that set to
+// rustyworld's OWN input handling (Vm::process_input, the canonical AW rules) through an
+// InputDevice. Nothing in the VM is overridden: this is the stock Vm::run() game loop, so what
+// you see is how a correct AW engine responds to exactly the presses you made.
+//
+//   cargo build --release --bin replaywatch
+//   cd <dir with data/>; replaywatch <aw-session-events.csv> [aw-session-inputs.csv]
+// The optional inputs.csv (the KN7000's applied vars) is printed beside each input change so the
+// two can be compared. Env: AW_SPEED (default 1 = authentic 20 ms slices), AW_SCALE (default 3).
+// Close the window or press Esc to quit.
+use ::minifb::{Key, ScaleMode, Window, WindowOptions};
+use std::cell::{Cell, RefCell};
+use std::collections::{HashMap, HashSet};
+use std::io::BufRead;
+use std::rc::Rc;
+
+use rustyworld::audio::Audio;
+use rustyworld::input::{Input, InputDevice};
+use rustyworld::minifb::MiniVideoAdapter;
+use rustyworld::music::Music;
+use rustyworld::*;
+
+const B_RIGHT: u8 = 1; const B_LEFT: u8 = 2; const B_DOWN: u8 = 4; const B_UP: u8 = 8; const B_ACT: u8 = 0x80;
+
+fn note_bits(n: i32) -> u8 {
+    if n <= 0 { return 0; }
+    if n <= 60 { return B_ACT; }        // C4 and the whole bass range = action
+    match n { 77 => B_LEFT, 81 => B_DOWN, 84 => B_RIGHT, 82 | 83 => B_UP, _ => 0 }
+}
+fn fmt_bits(b: u8) -> String {
+    let mut v = vec![];
+    if b & B_LEFT != 0 { v.push("LEFT") } if b & B_RIGHT != 0 { v.push("RIGHT") }
+    if b & B_UP != 0 { v.push("UP") } if b & B_DOWN != 0 { v.push("DOWN") }
+    if b & B_ACT != 0 { v.push("ACTION") }
+    if v.is_empty() { "-".into() } else { v.join("+") }
+}
+
+/// tick -> input bits held at that tick's ReadInput (rebuilt from the raw make/break stream)
+fn load_events(path: &str) -> (HashMap<u32, u8>, u32) {
+    let f = std::fs::File::open(path).expect("open events csv");
+    let mut held: HashSet<i32> = HashSet::new();
+    let mut map = HashMap::new(); let mut last = 0u32;
+    for line in std::io::BufReader::new(f).lines().flatten() {
+        let c: Vec<&str> = line.split(',').collect();
+        match c.first().copied() {
+            Some("K") if c.len() >= 5 => {
+                let note: i32 = c[3].parse().unwrap_or(0);
+                if c[4] == "1" { held.insert(note); } else { held.remove(&note); }
+            }
+            Some("R") if c.len() >= 5 => {
+                let tick: u32 = c[2].parse().unwrap_or(0);
+                let panel: u8 = c[4].parse().unwrap_or(0);
+                let bits = held.iter().fold(panel, |a, n| a | note_bits(*n));
+                map.insert(tick, bits); last = last.max(tick);
+            }
+            _ => {}
+        }
+    }
+    (map, last)
+}
+
+/// tick -> (lr, ud, action) the KN7000 applied (row F of inputs.csv drives tick F-1)
+fn load_applied(path: &str) -> HashMap<u32, (i32, i32, i32)> {
+    let mut m = HashMap::new();
+    if let Ok(f) = std::fs::File::open(path) {
+        for line in std::io::BufReader::new(f).lines().flatten() {
+            let c: Vec<&str> = line.split(',').collect();
+            if c.len() < 8 { continue; }
+            if let Ok(fr) = c[0].parse::<u32>() {
+                if fr >= 1 { m.insert(fr - 1, (c[2].parse().unwrap_or(0), c[3].parse().unwrap_or(0), c[6].parse().unwrap_or(0))); }
+            }
+        }
+    }
+    m
+}
+
+struct ReplayInput {
+    window: Rc<RefCell<Window>>,
+    by_tick: HashMap<u32, u8>,
+    applied: HashMap<u32, (i32, i32, i32)>,
+    last_tick: u32,
+    tick: Cell<u32>,
+    prev: Cell<u8>,
+}
+impl InputDevice for ReplayInput {
+    fn read_input(&self) -> HashSet<Input> {
+        let t = self.tick.get(); self.tick.set(t + 1);
+        {
+            let w = self.window.borrow();
+            if !w.is_open() || w.is_key_down(Key::Escape) { std::process::exit(0); }
+        }
+        let bits = self.by_tick.get(&t).copied().unwrap_or(0);
+        if t == self.last_tick + 1 { println!("--- end of recording (tick {}); the game keeps running without input ---", t); }
+        if bits != self.prev.get() || t == 0 {
+            let kn = self.applied.get(&t).map(|(lr, ud, a)| format!("   | KN7000 applied: LR={:+} UD={:+} ACT={}", lr, ud, a)).unwrap_or_default();
+            println!("tick {:5}  you held: {:<22}{}", t, fmt_bits(bits), kn);
+            self.prev.set(bits);
+        }
+        self.window.borrow_mut().set_title(&format!("rustyworld replay  tick {}/{}  input: {}", t, self.last_tick, fmt_bits(bits)));
+        let mut h = HashSet::new();
+        if bits & B_RIGHT != 0 { h.insert(Input::RIGHT); } if bits & B_LEFT != 0 { h.insert(Input::LEFT); }
+        if bits & B_DOWN != 0 { h.insert(Input::DOWN); } if bits & B_UP != 0 { h.insert(Input::UP); }
+        if bits & B_ACT != 0 { h.insert(Input::BUTTON); }
+        h
+    }
+}
+
+struct StubAudio;
+impl Audio for StubAudio { fn play_sound(&mut self,_:&[u8],_:u8,_:u8,_:u8){} fn stop(&mut self){} }
+struct StubMusic;
+impl Music for StubMusic {
+    fn start(&mut self,_:u16,_:Option<u16>,_:u8){} fn delay(&mut self,_:u16){} fn stop(&mut self){}
+    fn latest_mark(&mut self)->Option<i16>{None}
+}
+
+fn main() {
+    let args: Vec<String> = std::env::args().collect();
+    let ev = args.get(1).expect("usage: replaywatch <aw-session-events.csv> [aw-session-inputs.csv]");
+    let (by_tick, last_tick) = load_events(ev);
+    let applied = args.get(2).map(|p| load_applied(p)).unwrap_or_default();
+    let speed: usize = std::env::var("AW_SPEED").ok().and_then(|s| s.parse().ok()).unwrap_or(1);
+    let scale: usize = std::env::var("AW_SCALE").ok().and_then(|s| s.parse().ok()).unwrap_or(3);
+    println!("replaywatch: {} ticks of input from {}; speed x{}", last_tick + 1, ev, speed);
+
+    let window = Window::new("rustyworld replay", WIDTH as usize * scale, HEIGHT as usize * scale,
+        WindowOptions { resize: false, scale_mode: ScaleMode::AspectRatioStretch, ..WindowOptions::default() })
+        .expect("Unable to create window");
+    let window = Rc::new(RefCell::new(window));
+    let input = ReplayInput { window: window.clone(), by_tick, applied, last_tick, tick: Cell::new(0), prev: Cell::new(0) };
+    let resman = Rc::new(FileResourceManager::new().expect("index resources (need data/ in cwd)"));
+    let video = DefaultVideo::new(MiniVideoAdapter::sharing_window(window));
+    let mut vm = Vm::new(speed, video, resman, input, Box::new(StubAudio), Box::new(StubMusic));
+    vm.run();
+}
