+    /// KN7000 port: replay a session from the game's input log (kn7000 src/inplog.s; tools/aw_inplog.py's text,
+    /// parsed into AwrLog by bin/replayawr.rs). Starts as the port does: the splash (part 0x3E80 from its logo
+    /// sequence, as run_headless AW_SPLASH) when the log's first part is 0x3E80, else that part. Tick t is the
+    /// port's frame t (FRAME_NO while its threads run). At the start of each tick t >= 1, where the port's
+    /// ReadInput runs, the input the log says was applied at frame t: var 0xFA and 0xFE in the intro's mode, the six
+    /// hero variables from the mask otherwise, exactly as the port's ReadInput writes them; then an R record's part
+    /// switch (the port's InitForPart after ReadInput). Each M record's sync mark goes into var 0xF4 before the first
+    /// thread at or after its thread runs in its tick (no module player).
+    pub fn run_awr<F: FnMut(u32, &[i16; 256]) -> bool>(&mut self, log: &AwrLog, mut tick_cb: F) {
+        if log.start_part == 0x3E80 {
+            self.setup_part(0x3E80);
+            self.chans[0].exec_at(0x007B);
+            self.chans[60].exec_at(0x10A3);
+            self.state.vars[0xFF] = 2;
+        } else {
+            self.setup_part(log.start_part);
+            // AW_SETVARS="00=30,06=200" (hex var = decimal value): what the password part (0x3E88) sets before its
+            // UPDATE_MEMLIST, so a session can start at any checkpoint of a part. Unset: nothing changes.
+            if let Ok(sv) = std::env::var("AW_SETVARS") {
+                for kv in sv.split(',').filter(|x| !x.is_empty()) {
+                    let (k, v) = kv.split_once('=').expect("AW_SETVARS var=value");
+                    self.state.vars[usize::from_str_radix(k, 16).expect("var")] = v.parse().expect("value");
+                }
+            }
+        }
+        // AW_POKE="40:67=78:01=340,90:06=500" (decimal tick, then hex var = decimal value): sets the vars at the start
+        // of that tick, before its threads run (to teleport the hero for a probe). Unset: nothing changes.
+        let pokes: Vec<(u32, Vec<(usize, i16)>)> = std::env::var("AW_POKE").map(|s| s.split(',').filter(|x| !x.is_empty()).map(|e| {
+            let mut it = e.split(':');
+            let t: u32 = it.next().unwrap().parse().expect("AW_POKE tick");
+            (t, it.map(|kv| { let (k, v) = kv.split_once('=').expect("AW_POKE var=value");
+                (usize::from_str_radix(k, 16).expect("var"), v.parse().expect("value")) }).collect())
+        }).collect()).unwrap_or_default();
+        vclock::init();
+        let (mut tick, mut ii, mut mi): (u32, usize, usize) = (0, 0, 0);
+        loop {
+            crate::dbg::CUR_TICK.store(tick as i64, std::sync::atomic::Ordering::Relaxed);
+            for (t, kvs) in &pokes { if *t == tick { for &(k, v) in kvs { self.state.vars[k] = v; } } }
+            if tick >= 1 {
+                while ii + 1 < log.inputs.len() && log.inputs[ii + 1].0 <= tick { ii += 1; }
+                let (intro, m) = match log.inputs.get(ii) { Some(&(f, i, m)) if f <= tick => (i, m), _ => (false, 0) };
+                self.state.vars[VM_VAR_HERO_ACTION] = if m & 0x80 != 0 { 1 } else { 0 };
+                self.state.vars[VM_VAR_HERO_ACTION_MASK] = m as i16;
+                if !intro {
+                    let lr = if m & 1 != 0 { 1 } else if m & 2 != 0 { -1 } else { 0 };
+                    let ud = if m & 4 != 0 { 1 } else if m & 8 != 0 { -1 } else { 0 };
+                    self.state.vars[VM_VAR_HERO_POS_LEFT_RIGHT] = lr;
+                    self.state.vars[VM_VAR_HERO_POS_UP_DOWN] = ud;
+                    self.state.vars[VM_VAR_HERO_POS_JUMP] = ud;
+                    self.state.vars[VM_VAR_HERO_POS_MASK] = m as i16;
+                }
+                if let Some(&p) = log.reqs.get(&tick) { eprintln!("R -> {:#x} at tick {}", p, tick); self.setup_part(p); }
+            }
+            let mut chan_reqs = vec![];
+            for (chan_id, chan) in self.chans.iter_mut().enumerate() {
+                vclock::apply(tick, chan_id, &mut self.state.vars);
+                while mi < log.marks.len() && (log.marks[mi].0 < tick || (log.marks[mi].0 == tick && log.marks[mi].1 as usize <= chan_id)) {
+                    self.state.vars[VM_VAR_MUS_MARK] = log.marks[mi].2;
+                    mi += 1;
+                }
+                if let ChanStatus::Running(_) = chan.status {
+                    Vm::execute(&mut self.state, self.speed_up, chan, chan_id, &self.active_part, self.peripherals.borrow_mut(), &mut chan_reqs);
+                }
+            }
+            // the frame's end: the rest of its marks (thread 64: after its last thread), and the next frame's
+            // thread-0 ones (they appeared in the end-of-frame yield), as the MAME replay writes them
+            while mi < log.marks.len() && (log.marks[mi].0 <= tick || (log.marks[mi].0 == tick + 1 && log.marks[mi].1 == 0)) {
+                self.state.vars[VM_VAR_MUS_MARK] = log.marks[mi].2;
+                mi += 1;
+            }
+            vclock::tick_end(tick, self.state.vars[VM_VAR_PAUSE_SLICES]);
+            vclock::apply(tick, 64, &mut self.state.vars);
+            let keep_going = tick_cb(tick, &self.state.vars);
+            tick += 1;
+            let mut next_part: Option<u16> = None;
+            for req in chan_reqs {
+                match req {
+                    ChanReq::Part(p) => { next_part = Some(p); }
+                    ChanReq::SingleChanReq(chan_id, subreq) => {
+                        let chan = &mut self.chans[chan_id];
+                        match subreq {
+                            SingleChanReq::Exec(offset) => chan.exec_at(offset),
+                            SingleChanReq::Stop => chan.stop(),
+                            SingleChanReq::Pause => chan.pause(),
+                            SingleChanReq::Resume => chan.resume(),
+                        }
+                    }
+                }
+            }
+            if !keep_going { break; }
+            if let Some(p) = next_part { eprintln!("PARTSWITCH -> {:#x} at tick {}", p, tick); self.setup_part(p); }
+        }
+    }
