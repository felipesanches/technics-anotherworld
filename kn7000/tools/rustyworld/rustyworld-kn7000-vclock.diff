+            // The front buffer now holds this tick's final presented frame.
+            let keep_going = tick_cb(tick);
+            tick += 1;
+
+            let mut part_switch = false;
+            let mut next_part: Option<u16> = None;
+            for req in chan_reqs {
+                match req {
+                    ChanReq::Part(p) => { part_switch = true; next_part = Some(p); }
+                    ChanReq::SingleChanReq(chan_id, subreq) => {
+                        let chan = &mut self.chans[chan_id];
+                        match subreq {
+                            SingleChanReq::Exec(offset) => chan.exec_at(offset),
+                            SingleChanReq::Stop => chan.stop(),
+                            SingleChanReq::Pause => chan.pause(),
+                            SingleChanReq::Resume => chan.resume(),
+                        }
+                    }
+                }
+            }
+            if !keep_going { break; }
+            // KN7000 port: START_PART=0x3E8n switches to that part at the end of tick 0, exactly
+            // where the KN7000 probe (awcksum.lua AW_START_PART) makes the port switch.
+            if tick == 1 {
+                if let Ok(p) = std::env::var("START_PART") {
+                    let p = u16::from_str_radix(p.trim_start_matches("0x"), 16).expect("START_PART hex");
+                    eprintln!("START_PART -> {:#x} at tick {}", p, tick);
+                    self.setup_part(p);
+                    continue;
+                }
+            }
