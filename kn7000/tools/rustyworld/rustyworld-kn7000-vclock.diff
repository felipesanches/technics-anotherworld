+            // logo/credits sequence 0x007B, the display loop on thread 60 at 0x10A3, var[0xFF] = 2
+            // -- what the part's own entry 0x0000 sets up, minus the code wheel (thread 20).
+            self.setup_part(0x3E80);
+            self.chans[0].exec_at(0x007B);
+            self.chans[60].exec_at(0x10A3);
+            self.state.vars[0xFF] = 2;
+        } else {
+            self.setup_part(GAME_PART2);
+        }
+        let mut tick: u32 = 0;
+        loop {
+            crate::dbg::CUR_TICK.store(tick as i64, std::sync::atomic::Ordering::Relaxed);
+            if tick as i64 == crate::dbg::DUMP_TICK.load(std::sync::atomic::Ordering::Relaxed) {
+                let vs: Vec<String> = self.state.vars.iter().enumerate().filter(|(_,x)| **x != 0).map(|(i,x)| format!("{:02x}={}", i, x)).collect();
+                eprintln!("VARS {}", vs.join(" "));
+            }
+            self.process_input(self.peripherals.input_device.read_input());
+
+            let mut chan_reqs = vec![];
+            for (chan_id, chan) in self.chans.iter_mut().enumerate() {
+                if let ChanStatus::Running(_) = chan.status {
+                    Vm::execute(&mut self.state, self.speed_up, chan, chan_id, &self.active_part, self.peripherals.borrow_mut(), &mut chan_reqs);
+                }
+            }
