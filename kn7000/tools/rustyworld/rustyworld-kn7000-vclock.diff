+pub mod vclock {
+    use std::cell::RefCell;
+    use std::io::Write;
+    pub struct VClock {
+        pub model: String, pub per_blit: bool, pub now: f64, pub slice: f64,
+        pub playing: bool, pub next: f64, pub row: usize, pub period: f64, pub res: u16,
+        pub mods: Vec<(u16, usize, Vec<(usize, i16)>)>, pub out: Option<std::fs::File>, pub blits: u32,
+    }
+    thread_local! { pub static VC: RefCell<Option<VClock>> = RefCell::new(None); }
+    pub fn row_ms(model: &str, delay: u16) -> f64 {
+        let d = delay as f64;
+        match model {
+            "amiga_pal" => 6.0 * d / 709379.0 * 1000.0,           // CIA-A timer A latch = delay, a row every 6th underflow
+            "amiga_ntsc" => 6.0 * d / 715909.0 * 1000.0,
+            "dos" => { let t = (delay as u32 * 600 / 7050 + 1) as f64; t / (1193182.0 / 119.0) * 1000.0 }
+            "rawgl" => { let ms = delay as u32 * 60 * 1000 / 7159092; (44100 * ms / 1000) as f64 / 44100.0 * 1000.0 }
+            "sanglard" | "rustyworld" => (delay as u32 * 60 / 7050) as f64,
+            "ours" => (delay as u32 * 2146 / 1000) as f64 / 256.0,
+            "ours_pal" => ((delay as u32 * 35476) >> 14) as f64 / 256.0,   // the port since music-timing: Amiga PAL
+            _ => panic!("AW_VMODEL {}", model),
+        }
+    }
+    pub fn slice_ms(model: &str) -> f64 {
