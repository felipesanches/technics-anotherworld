+                    if let Some(f) = c.out.as_mut() { writeln!(f, "M {} {} {} {} {:.3}", tick, chan, val, row, t).unwrap(); }
+                }
+                c.row += 1; c.next += c.period;
+                if c.row >= nrows { c.playing = false; }
+            }
+        })
+    }
+}
