+    /// Differential-replay driver. Like run_headless, but instead of reading an input device
+    /// each tick it OVERRIDES the six hero-input variables with the values recorded from a
+    /// KN7000 play session (probes/awmonitor.lua -> aw-inputs.csv), keyed by VM tick/frame
+    /// (default 0 = no input for any tick absent from the map, e.g. early intro frames).
+    /// It always continues through part switches, so the same intro->water path runs. Feeding
+    /// both VMs the identical applied inputs isolates any divergence to VM logic / rendering.
+    pub fn run_replay<F: FnMut(u32) -> bool>(&mut self, inputs: &std::collections::HashMap<u32,[i16;6]>, mut tick_cb: F) {
+        self.setup_part(GAME_PART2);
+        let mut tick: u32 = 0;
+        let dump_from: i64 = std::env::var("DUMP_FROM").ok().and_then(|s| s.parse().ok()).unwrap_or(-1);
+        let dump_to: i64   = std::env::var("DUMP_TO").ok().and_then(|s| s.parse().ok()).unwrap_or(-1);
+        loop {
+            crate::dbg::CUR_TICK.store(tick as i64, std::sync::atomic::Ordering::Relaxed); // enables the PCT opcode trace at DUMP_TICK
+            if (tick as i64) >= dump_from && (tick as i64) <= dump_to {
+                // state at the START of this tick (after the previous tick's execution)
+                let vs: Vec<String> = self.state.vars.iter().enumerate().filter(|(_,x)| **x != 0).map(|(i,x)| format!("{:02x}={}", i, x)).collect();
+                eprintln!("VARS t={} {}", tick, vs.join(" "));
+            }
+            let r = inputs.get(&tick).copied().unwrap_or([0i16;6]);
+            self.state.vars[VM_VAR_HERO_POS_LEFT_RIGHT] = r[0];
+            self.state.vars[VM_VAR_HERO_POS_UP_DOWN]    = r[1];
+            self.state.vars[VM_VAR_HERO_POS_JUMP]       = r[2];
+            self.state.vars[VM_VAR_HERO_POS_MASK]       = r[3];
+            self.state.vars[VM_VAR_HERO_ACTION]         = r[4];
+            self.state.vars[VM_VAR_HERO_ACTION_MASK]    = r[5];
+
+            let mut chan_reqs = vec![];
+            for (chan_id, chan) in self.chans.iter_mut().enumerate() {
+                if let ChanStatus::Running(_) = chan.status {
+                    Vm::execute(&mut self.state, self.speed_up, chan, chan_id, &self.active_part, self.peripherals.borrow_mut(), &mut chan_reqs);
+                }
+            }
+            let keep_going = tick_cb(tick);
+            tick += 1;
+
+            let mut next_part: Option<u16> = None;
+            for req in chan_reqs {
+                match req {
+                    ChanReq::Part(p) => { next_part = Some(p); }
+                    ChanReq::SingleChanReq(chan_id, subreq) => {
+                        let chan = &mut self.chans[chan_id];
+                        match subreq {
+                            SingleChanReq::Exec(offset) => chan.exec_at(offset),
+                            SingleChanReq::Stop => chan.stop(),
+                            SingleChanReq::Pause => chan.pause(),
+                            SingleChanReq::Resume => chan.resume(),
+                        }
+                    }
+                }
+            }
+            if !keep_going { break; }
+            // KN7000 port: START_PART as in run_headless (kn7000/probes/awreplay.lua AW_START_PART)
+            if tick == 1 {
+                if let Ok(sp) = std::env::var("START_PART") {
+                    let sp = u16::from_str_radix(sp.trim_start_matches("0x"), 16).expect("START_PART hex");
+                    eprintln!("START_PART -> {:#x} at tick {}", sp, tick);
+                    self.setup_part(sp);
+                    continue;
+                }
+            }
+            if let Some(p) = next_part { self.setup_part(p); }
+        }
+    }
